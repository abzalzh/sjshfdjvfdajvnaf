meta {
  name: 59 Preflight from the page
  type: http
  seq: 59
}

options {
  url: {{baseUrl}}/rooms/1/messages
  body: none
  auth: none
}

headers {
  Origin: http://127.0.0.1:5500
  Access-Control-Request-Method: POST
  Access-Control-Request-Headers: authorization,content-type
}

assert {
  res.status: eq 200
  res.headers['access-control-allow-origin']: eq http://127.0.0.1:5500
}
